# AEGIS Backend Environment Configuration
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
UVICORN_WORKERS=1

# Authentication & JWT Security Settings
# Generate a cryptographically secure 256-bit (at least 32 bytes) key:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_your_secure_256_bit_secret_key_here

# Groq Cloud AI Engine Configuration (Clinical Entity Extraction)
# Obtain an API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Database Configuration (SQLite + aiosqlite)
# DATABASE_URL=sqlite+aiosqlite:///c:/Surya/AI Form Application/backend/data/patient_registration.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30.0
DB_BUSY_TIMEOUT=5000

# CORS Allowed Origins (Comma-separated or JSON list)
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
